{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "enum": [
        "fixture",
        "production"
      ]
    },
    "episodeId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "enum": [
        "technology",
        "work_money",
        "science_society"
      ]
    },
    "centralQuestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1,
      "maxItems": 80
    },
    "utterances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/utterance"
      },
      "minItems": 1,
      "maxItems": 140
    },
    "learningPoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learningPoint"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 3,
      "maxItems": 25
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "titleJa": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "thumbnailJa": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              }
            },
            "required": [
              "titleJa",
              "thumbnailJa"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "selectedIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "candidates",
        "selectedIndex"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "episodeId",
    "revision",
    "generatedAt",
    "asOf",
    "category",
    "centralQuestion",
    "answer",
    "sources",
    "claims",
    "utterances",
    "learningPoints",
    "scenes",
    "packaging"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nomuonji/english-youtube/blob/main/schemas/episode.schema.json",
  "title": "EpisodeManifest v2",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publishedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "independenceGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "isPrimary": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "publishedDate",
        "retrievedAt",
        "independenceGroup",
        "isPrimary"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "certainty": {
          "enum": [
            "confirmed",
            "reported",
            "estimate",
            "forecast",
            "disputed",
            "inference"
          ]
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "supportNote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "sourceId",
              "locator",
              "supportNote"
            ]
          },
          "minItems": 1,
          "maxItems": 6
        }
      },
      "required": [
        "id",
        "text",
        "certainty",
        "asOf",
        "evidence"
      ]
    },
    "utterance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          },
          "minItems": 1,
          "maxItems": 4
        },
        "translationJa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "translationJaChunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          }
        }
      },
      "required": [
        "id",
        "text",
        "chunks",
        "translationJa",
        "claimIds",
        "translationJaChunks"
      ]
    },
    "learningPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "phrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "meaningJa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "sourceUtteranceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "id",
        "phrase",
        "meaningJa",
        "sourceUtteranceId"
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "role": {
          "enum": [
            "hook",
            "story",
            "phrase",
            "retrieval",
            "recap"
          ]
        },
        "beat": {
          "enum": [
            null,
            "setup",
            "mechanism",
            "complication",
            "answer"
          ]
        },
        "utteranceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "visual": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "card"
                },
                "headline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "body": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 120
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 20
                }
              },
              "required": [
                "type",
                "headline",
                "body",
                "claimIds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "metric"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                },
                "qualifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              },
              "required": [
                "type",
                "value",
                "unit",
                "label",
                "qualifier",
                "claimIds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "chain"
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      },
                      "revealAtUtteranceId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,63}$"
                      }
                    },
                    "required": [
                      "label",
                      "revealAtUtteranceId"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 4
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              },
              "required": [
                "type",
                "nodes",
                "claimIds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "compare"
                },
                "leftTitle": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "rightTitle": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "aspect": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24
                      },
                      "left": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "right": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "revealAtUtteranceId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,63}$"
                      }
                    },
                    "required": [
                      "aspect",
                      "left",
                      "right",
                      "revealAtUtteranceId"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              },
              "required": [
                "type",
                "leftTitle",
                "rightTitle",
                "rows",
                "claimIds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "timeline"
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "dateLabel": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 48
                      },
                      "revealAtUtteranceId": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,63}$"
                      }
                    },
                    "required": [
                      "dateLabel",
                      "label",
                      "revealAtUtteranceId"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 4
                },
                "claimIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "minItems": 1,
                  "maxItems": 10
                }
              },
              "required": [
                "type",
                "events",
                "claimIds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "phrase"
                },
                "learningPointId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "required": [
                "type",
                "learningPointId"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "retrieval"
                },
                "sourceUtteranceId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "correctIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "answerJa": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                }
              },
              "required": [
                "type",
                "sourceUtteranceId",
                "question",
                "options",
                "correctIndex",
                "answerJa"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "recap"
                },
                "learningPointIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "uniqueItems": true
                }
              },
              "required": [
                "type",
                "learningPointIds"
              ]
            }
          ]
        },
        "glossLearningPointId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "beat",
        "utteranceIds",
        "visual",
        "glossLearningPointId"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "hook"
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "properties": {
                  "type": {
                    "enum": [
                      "card",
                      "metric",
                      "chain",
                      "compare",
                      "timeline"
                    ]
                  }
                }
              },
              "beat": {
                "type": "null"
              },
              "utteranceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "story"
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "properties": {
                  "type": {
                    "enum": [
                      "card",
                      "metric",
                      "chain",
                      "compare",
                      "timeline"
                    ]
                  }
                }
              },
              "beat": {
                "enum": [
                  "setup",
                  "mechanism",
                  "complication",
                  "answer"
                ]
              },
              "utteranceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "phrase"
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "properties": {
                  "type": {
                    "enum": [
                      "phrase"
                    ]
                  }
                }
              },
              "beat": {
                "type": "null"
              },
              "utteranceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "retrieval"
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "properties": {
                  "type": {
                    "enum": [
                      "retrieval"
                    ]
                  }
                }
              },
              "beat": {
                "type": "null"
              },
              "utteranceIds": {
                "minItems": 0,
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "recap"
              }
            }
          },
          "then": {
            "properties": {
              "visual": {
                "properties": {
                  "type": {
                    "enum": [
                      "recap"
                    ]
                  }
                }
              },
              "beat": {
                "type": "null"
              },
              "utteranceIds": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 3
          },
          "scenes": {
            "minItems": 13
          }
        }
      }
    }
  ]
}
