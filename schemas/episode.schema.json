{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/english-youtube/episode.schema.json",
  "title": "EpisodeManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episodeId",
    "generatedAt",
    "topic",
    "centralQuestion",
    "editorialMode",
    "audience",
    "sources",
    "claims",
    "scenes",
    "learningPoints",
    "packaging"
  ],
  "properties": {
    "episodeId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "topic": {
      "type": "string",
      "minLength": 5,
      "maxLength": 180
    },
    "centralQuestion": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "editorialMode": {
      "enum": ["explainer", "timeline", "two_sides"]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["englishLevel", "primaryLanguage"],
      "properties": {
        "englishLevel": {
          "enum": ["B1", "B1-B2", "B2"]
        },
        "primaryLanguage": {
          "const": "ja"
        },
        "assumedKnowledge": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "url", "publishedAt", "sourceType"],
        "properties": {
          "id": {"type": "string", "pattern": "^src-[a-zA-Z0-9_-]+$"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "publishedAt": {"type": "string", "format": "date-time"},
          "eventDate": {"type": ["string", "null"], "format": "date"},
          "sourceType": {
            "enum": ["primary", "major_news", "specialist", "academic", "government", "company", "other"]
          },
          "notes": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sourceIds", "certainty"],
        "properties": {
          "id": {"type": "string", "pattern": "^claim-[a-zA-Z0-9_-]+$"},
          "text": {"type": "string"},
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "certainty": {
            "enum": ["confirmed", "reported", "estimate", "forecast", "disputed"]
          },
          "attribution": {"type": "string"}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/scene"}
    },
    "learningPoints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phrase", "meaningJa", "sourceSceneIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^lp-[a-zA-Z0-9_-]+$"},
          "phrase": {"type": "string"},
          "meaningJa": {"type": "string"},
          "noteJa": {"type": "string"},
          "example": {"type": "string"},
          "sourceSceneIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleCandidates", "thumbnailTextCandidates"],
      "properties": {
        "titleCandidates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {"type": "string", "maxLength": 100}
        },
        "thumbnailTextCandidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {"type": "string", "maxLength": 40}
        },
        "descriptionDraft": {"type": "string"}
      }
    },
    "sceneLibraryRequest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "need": {"type": "string"},
        "whyExistingScenesFail": {"type": "string"},
        "proposedPrimitive": {"type": "string"}
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "purpose", "narration"],
      "properties": {
        "id": {"type": "string", "pattern": "^scene-[a-zA-Z0-9_-]+$"},
        "type": {
          "enum": [
            "cold_open",
            "headline",
            "narrative",
            "number_reveal",
            "timeline",
            "map",
            "entity_profile",
            "quote",
            "cause_effect",
            "comparison",
            "before_after",
            "process",
            "question",
            "english_lens",
            "chunk_breakdown",
            "listening_challenge",
            "prediction",
            "counterpoint",
            "what_next",
            "recap"
          ]
        },
        "variant": {"type": "string"},
        "purpose": {"type": "string", "minLength": 3},
        "narration": {"type": "string"},
        "claimIds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "durationHintSec": {
          "type": "number",
          "minimum": 2,
          "maximum": 180
        },
        "tempo": {
          "enum": ["slow", "normal", "fast"]
        },
        "density": {
          "enum": ["low", "medium", "high"]
        },
        "onScreen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headline": {"type": "string"},
            "subheadline": {"type": "string"},
            "labels": {
              "type": "array",
              "items": {"type": "string"}
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["label"],
                "properties": {
                  "label": {"type": "string"},
                  "value": {"type": ["string", "number"]},
                  "description": {"type": "string"}
                }
              }
            }
          }
        },
        "caption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chunks": {
              "type": "array",
              "items": {"type": "string"}
            },
            "highlight": {
              "type": "array",
              "items": {"type": "string"}
            },
            "japaneseGloss": {"type": "string"}
          }
        },
        "learningPointIds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "assetRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "purpose"],
            "properties": {
              "kind": {"enum": ["image", "icon", "map", "chart", "logo", "screenshot", "none"]},
              "query": {"type": "string"},
              "purpose": {"type": "string"},
              "fallback": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
